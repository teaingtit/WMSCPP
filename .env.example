# -------------------------------------------------------------------------
# Supabase Configuration
# Required for: Authentication, Database Connection, and Realtime Subscriptions
# -------------------------------------------------------------------------
# URL ของ Supabase Project (ดูได้ที่ Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Key สำหรับใช้งานฝั่ง Client (ปลอดภัยที่จะเปิดเผยใน Browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Key สำหรับใช้งานฝั่ง Server เท่านั้น (ห้ามใช้ใน Client Component เด็ดขาด!)
# ใช้สำหรับ Admin Task หรือการข้าม RLS Policy
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------------------
# Database Connection (Transaction Mode)
# Required for: Drizzle ORM / Prisma / Direct SQL Connections
# -------------------------------------------------------------------------
# รูปแบบ: postgresql://[user]:[password]@[host]:[port]/[db]?pgbouncer=true
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"

# -------------------------------------------------------------------------
# MSSQL Configuration (Legacy/ERP System Integration)
# Required for: Direct connection to Microsoft SQL Server
# -------------------------------------------------------------------------
# MSSQL Connection String
MSSQL_SERVER=your-server-name.database.windows.net
MSSQL_PORT=1433
MSSQL_DATABASE=your_database_name
MSSQL_USER=your_username
MSSQL_PASSWORD=your_password
# Encrypt connection? (true สำหรับ Azure SQL, false สำหรับ On-Premise)
MSSQL_ENCRYPT=true
# Trust Server Certificate (ใช้ true สำหรับ Self-Signed Cert)
MSSQL_TRUST_SERVER_CERTIFICATE=false

# -------------------------------------------------------------------------
# Database Provider Selection (Repository Factory)
# -------------------------------------------------------------------------
# ระบุ Database Provider ที่จะใช้เป็นหลัก
# Values: 'SUPABASE' หรือ 'MSSQL'
# Default: SUPABASE (ถ้าไม่ระบุ)
DB_PROVIDER=SUPABASE

# -------------------------------------------------------------------------
# AI Integration (Google Gemini)
# Required for: Generative AI features
# -------------------------------------------------------------------------
# API Key จาก Google AI Studio
GOOGLE_API_KEY=AIzaSy...

# -------------------------------------------------------------------------
# App Configuration
# -------------------------------------------------------------------------
# URL หลักของเว็บไซต์ (ใช้สำหรับการ Redirect หลัง Login)
NEXT_PUBLIC_APP_URL=http://localhost:3000